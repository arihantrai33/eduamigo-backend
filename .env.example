# Copy to .env and fill in. Never commit the real .env.

# Required
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/eduamigo
JWT_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Frontend origins allowed to call the API (comma separated). Leave empty only for local development.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
PORT=8000

# Optional
JWT_EXPIRES_IN=7d
SCHOOL_TIMEZONE=Asia/Kolkata
LEAVE_QUOTA_DAYS=12
DISABLE_JOBS=false

# Cloudinary (notes PDFs, photos, chat attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase (live bus tracking). Paste the service account JSON on one line.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=https://eduamigo-375c7-default-rtdb.asia-southeast1.firebasedatabase.app

# AI revision (Gemini)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
VECTOR_INDEX_NAME=vector_index
REVISION_MIN_SCORE=0.75
REVISION_HOURLY_LIMIT=40

# EduAmigo Ask (see docs/EDUAMIGO_ASK.md). Works without a model (keywords and record-based answers);
# a model adds Hindi/Hinglish wording, general answers and routing of unusual questions.
# Azure OpenAI first, Gemini (above) as automatic fallback.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21
ASSISTANT_PROVIDERS=azure,gemini
ASSISTANT_TIMEOUT_MS=6000
ASSISTANT_REWRITE=auto
ASSISTANT_HOURLY_LIMIT=120
# Natural spoken voice for the AI Tutor (Gemini text-to-speech, uses GEMINI_API_KEY). Set ASSISTANT_TTS=off to use only the
# device's own voice. Each spoken piece counts against the school's AI budget (feature "Spoken answers").
# ASSISTANT_TTS=on
# ASSISTANT_TTS_MODEL=gemini-3.8-flash-tts
# ASSISTANT_TTS_VOICE=Achird
# SPEECH_HOURLY_LIMIT=300

# Encrypts per-school secrets such as payment gateway keys (see docs/PAYMENTS.md)
DATA_ENCRYPTION_KEY=

# Email for password reset codes (see docs/SIGN_IN.md). brevo | resend | log
EMAIL_PROVIDER=brevo
EMAIL_FROM=EduAmigo <no-reply@yourdomain.in>
BREVO_API_KEY=
RESEND_API_KEY=

# Owner console integrations (docs/INTEGRATIONS.md). Email and SMS settings are saved in the console, not here.
# Local development only: allow a mail catcher on a private address (never set in production).
# ALLOW_PRIVATE_SMTP_HOSTS=true
# Test sends from the console per owner account per 15 minutes (default 30).
# INTEGRATION_TESTS_PER_15_MIN=30

# Sign-in password checks (services/passwordHash.js). Defaults suit most servers; only change after measuring.
# PASSWORD_CHECK_CONCURRENCY=3   # checks at once; default is worker threads - 1 (UV_THREADPOOL_SIZE, default 4)
# PASSWORD_CHECK_QUEUE=300       # checks allowed to wait; beyond this a sign-in gets a 503 "busy"

# Needed in production, see docs/PRODUCTION_GO_LIVE.md
# The API's own public https address. Student photo and attachment links are built from it (the website is on another domain).
# PUBLIC_API_URL=https://your-api.onrender.com
# School addresses like abc.yourdomain.in (needs wildcard DNS and TLS first; leave unset until then).
# PLATFORM_BASE_DOMAIN=
# Bus routes that follow roads. Mapbox if a token is set, otherwise the public OSRM service; ROUTING_URL=off keeps straight lines.
# MAPBOX_ACCESS_TOKEN=
# ROUTING_URL=
# Photos: Cloudinary when its three keys are set, otherwise PHOTO_STORAGE=local (a folder on the server: lost on redeploy, use only for testing).
# PHOTO_STORAGE=local
